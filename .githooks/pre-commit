#!/bin/sh
# Every commit regenerates both outputs for all sales deliverables:
#   GitHub Pages page + HubSpot import fragment
# (three decks, case studies, comparisons). See build-all.py.
#
# Wired via: git config core.hooksPath .githooks
# Bypass once with: git commit --no-verify

set -e

python build-all.py

# Stage the regenerated outputs so they land in this commit.
git add \
  sales-presentation/generated/overview/index.html \
  sales-presentation/generated/overview/hubspot.html \
  sales-presentation/generated/specify/index.html \
  sales-presentation/generated/specify/hubspot.html \
  sales-presentation/generated/optimize/index.html \
  sales-presentation/generated/optimize/hubspot.html \
  case-studies/hubspot \
  comparisons/hubspot

# Prose gate. Staged HTML and Markdown are checked against the house-voice rule
# bank. Context is taken from the path, because a question heading is correct in
# a guide FAQ and wrong in a section heading.
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(html|md)$' || true)
for f in $STAGED; do
  [ -f "$f" ] || continue
  # The five decks are out of scope. Deck copy answers to the slide budgets in
  # CLAUDE.md rather than the prose rule bank, which is written for running
  # prose: a deck headline is the section, not an introduction to one, and a
  # stat tile is a label with a full stop. Sources and built output both.
  case "$f" in
    akka-overview/*|akka-sdk/*|akka-verify/*|sales-presentation/*)
      continue ;;
    # blog-technical/posts/ is scaffolded from live akka.io posts and carries
    # their prose verbatim — scaffold.py invents no text. The rule bank judges
    # copy we write, and rewriting a published author's post to pass it would
    # change what the post says. The hand-authored exemplars one level up
    # (blog-technical/*.html) are ours and stay in scope.
    blog-technical/posts/*)
      continue ;;
  esac
  case "$f" in
    website/guides*)                 CTX=guide ;;
    website/*)                       CTX=web ;;
    case-studies/*)                  CTX=case-study ;;
    battlecards/*)                   CTX=battlecard ;;
    comparisons/*)                   CTX=web ;;
    blog-technical/*)                CTX=blog ;;
    # Sales enablement. Trade terms like "the wedge" are precise in a playbook
    # and are metaphors in customer copy, so this content carries its own context.
    enablement/*)                    CTX=internal ;;
    *)                               CTX=web ;;
  esac
  python tools/auditors/voice/audit.py --context "$CTX" "$f" || {
    echo ""
    echo "Prose gate failed on $f."
    echo "Fix the violations, or commit with --no-verify if the auditor is wrong."
    exit 1
  }
done
